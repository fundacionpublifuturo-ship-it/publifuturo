{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Accept-Ranges", "value": "none" }
      ]
    },
    {
      "source": "/og.jpg",
      "headers": [
        { "key": "Content-Type", "value": "image/jpeg" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
